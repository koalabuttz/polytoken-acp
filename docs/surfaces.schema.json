{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polytoken ACP surfaces extension version 1",
  "description": "Operational bounds, byte/header semantics, and event ordering are additionally normative in surfaces.md. Result schemas are selected using the originating RPC method.",
